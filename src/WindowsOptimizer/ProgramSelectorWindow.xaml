<Window x:Class="WindowsOptimizer.ProgramSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programs Library"
        Width="1100"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B1020"
        Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Programs Library"
                       FontSize="32"
                       FontWeight="Bold"/>
            <TextBlock Text="Choose programs and build your custom package."
                       Margin="0,6,0,0"
                       Foreground="#AAB4D0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Height="42"
                     Padding="12"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox x:Name="CategoryBox"
                      Grid.Column="1"
                      Margin="12,0,0,0"
                      Height="42"
                      VerticalContentAlignment="Center"
                      SelectionChanged="CategoryBox_SelectionChanged"/>

            <Button Grid.Column="2"
                    Content="Clear"
                    Width="90"
                    Height="42"
                    Margin="12,0,0,0"
                    Click="Clear_Click"/>
        </Grid>

        <Border Grid.Row="2"
                CornerRadius="14"
                BorderBrush="#293452"
                BorderThickness="1"
                Background="#11182B"
                Padding="12">

            <ListView x:Name="ProgramsList"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected}"
                                  Padding="10"
                                  Margin="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Category}"
                                           Foreground="#8F9AB8"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="SelectionText"
                       VerticalAlignment="Center"
                       Foreground="#AAB4D0"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Select visible"
                        Width="130"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="SelectVisible_Click"/>

                <Button Content="Save selection"
                        Width="140"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="Save_Click"/>

                <Button Content="Close"
                        Width="100"
                        Height="42"
                        Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
