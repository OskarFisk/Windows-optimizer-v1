<Window x:Class="WindowsOptimizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows Optimizer v1" Width="1400" Height="860" MinWidth="1050" MinHeight="650" Background="#070A10" Foreground="#F5F7FF" WindowStartupLocation="CenterScreen">
<Window.Resources>
<SolidColorBrush x:Key="Panel" Color="#101722"/>
<SolidColorBrush x:Key="Line" Color="#26344A"/>
<SolidColorBrush x:Key="Muted" Color="#8D9AAF"/>
<Style TargetType="Button"><Setter Property="Foreground" Value="#F5F7FF"/><Setter Property="Background" Value="#151F2E"/><Setter Property="BorderBrush" Value="#2B3B55"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FontSize" Value="14"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Background="#0B1018" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"><Grid Margin="26,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="WINDOWS OPTIMIZER" FontSize="23" FontWeight="ExtraBold"/><TextBlock Text="v1  •  Performance cockpit" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#10251D" CornerRadius="14" Padding="12,7" Margin="0,0,12,0"><TextBlock Text="●  SYSTEM READY" Foreground="#70F2B0" FontWeight="Bold"/></Border><Button Content="RESCAN" Click="Scan_Click" Margin="0" Padding="15,9"/></StackPanel></Grid></Border>
<Grid Grid.Row="1" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Panel}" CornerRadius="18" Padding="12"><StackPanel><TextBlock Text="CONTROL CENTER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="8,6,8,14"/><Button Content="⌂   Dashboard" Click="Dashboard_Click"/><Button Content="⚡   Optimize" Click="Optimize_Click"/><Button Content="◈   Debloat" Click="Debloat_Click"/><Button Content="▦   Programs Library" Click="Programs_Click"/><Button Content="◉   Hardware Monitor" Click="Monitor_Click"/><Button Content="⚙   Settings" Click="Settings_Click"/><Separator Background="{StaticResource Line}" Margin="5,10"/><Button Content="Ninite  •  App Installer" Click="Ninite_Click"/><TextBlock Text="UAC is requested only when an operation actually needs administrator access." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="8,16,8,0"/></StackPanel></Border>
<ScrollViewer Grid.Column="1" Margin="18,0,0,0"><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="34" FontWeight="ExtraBold" Margin="4,0,0,2"/><TextBlock x:Name="Status" Text="Ready. Scan your PC to refresh live metrics." Foreground="{StaticResource Muted}" Margin="4,0,0,20"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="17" Margin="0,0,9,0"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CpuText" Text="--" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="process load" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="16" Padding="17" Margin="0,0,9,0"><StackPanel><TextBlock Text="RAM" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RamText" Text="--" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="RamSubText" Text="physical memory" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="17" Margin="0,0,9,0"><StackPanel><TextBlock Text="SYSTEM DRIVE" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DiskText" Text="--" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="free space" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Grid.Column="3" Background="{StaticResource Panel}" CornerRadius="16" Padding="17"><StackPanel><TextBlock Text="UPTIME" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UptimeText" Text="--" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock Text="since boot" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border></Grid>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="0,0,10,0"><StackPanel><TextBlock Text="QUICK ACTIONS" FontSize="18" FontWeight="Bold"/><TextBlock Text="Safe maintenance actions. Nothing is applied silently." Foreground="{StaticResource Muted}" Margin="0,4,0,17"/><WrapPanel><Button Content="Clean temporary files" Click="CleanTemp_Click" Margin="0,0,9,9"/><Button Content="Flush DNS cache" Click="FlushDns_Click" Margin="0,0,9,9"/><Button Content="Clear standby RAM" Click="RamClean_Click" Margin="0,0,9,9"/><Button Content="Windows Update" Click="WindowsUpdate_Click" Margin="0,0,9,9"/></WrapPanel><Border Background="#0C111A" CornerRadius="12" Padding="14"><StackPanel><TextBlock Text="RAM cleaner" FontWeight="Bold"/><TextBlock Text="Uses Microsoft Sysinternals RAMMap to empty the Windows standby list, then refreshes the dashboard." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="18" Padding="22"><StackPanel><TextBlock Text="PROGRAMS" FontSize="18" FontWeight="Bold"/><TextBlock Text="Trusted launchers and tuning tools." Foreground="{StaticResource Muted}" Margin="0,4,0,17"/><Button Content="Open Ninite library" Click="Ninite_Click"/><Button Content="MSI Afterburner" Click="Afterburner_Click"/><Button Content="AMD Ryzen Master" Click="RyzenMaster_Click"/><Button Content="BlueStacks" Click="BlueStacks_Click"/></StackPanel></Border></Grid>
<Border Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="0,16,0,24"><StackPanel><TextBlock Text="ACTIVITY" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="ActivityText" Text="No actions yet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Grid></Grid></Window>