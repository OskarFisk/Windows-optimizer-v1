<Window x:Class="WindowsOptimizer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows Optimizer v1" Width="1200" Height="760" MinWidth="900" MinHeight="600" Background="#111318"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="WINDOWS OPTIMIZER" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="Windows 11 • Desktop &amp; Laptop" Foreground="#AAB0BC" FontSize="14" Margin="0,4,0,20"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Background="#191C23" Margin="0,0,16,0"><Button Content="Dashboard" Click="Dashboard_Click" Margin="10" Padding="12"/><Button Content="Optimize" Click="Optimize_Click" Margin="10" Padding="12"/><Button Content="Debloat" Click="Debloat_Click" Margin="10" Padding="12"/><Button Content="Programs Library" Click="Programs_Click" Margin="10" Padding="12"/><Button Content="Hardware Monitor" Click="Monitor_Click" Margin="10" Padding="12"/><Button Content="Settings" Click="Settings_Click" Margin="10" Padding="12"/></StackPanel><Border Grid.Column="1" Background="#191C23" CornerRadius="12" Padding="24"><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Ready. Privileged operations request UAC only when required." Foreground="#AAB0BC" Margin="0,8,0,20"/><UniformGrid Columns="3"><Border Background="#222630" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="CPU" Foreground="#AAB0BC"/><TextBlock x:Name="CpuText" Text="--" Foreground="White" FontSize="25"/></StackPanel></Border><Border Background="#222630" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="RAM" Foreground="#AAB0BC"/><TextBlock x:Name="RamText" Text="--" Foreground="White" FontSize="25"/></StackPanel></Border><Border Background="#222630" CornerRadius="10" Padding="18" Margin="5"><StackPanel><TextBlock Text="Disk" Foreground="#AAB0BC"/><TextBlock x:Name="DiskText" Text="--" Foreground="White" FontSize="25"/></StackPanel></Border></UniformGrid><Button Content="Scan system" Click="Scan_Click" Padding="12" Margin="5,25,5,5"/></StackPanel></Border></Grid></Grid></Window>